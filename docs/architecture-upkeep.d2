# joyshare: what keeps it running: alerts, updates, backups
# Source of docs/architecture-upkeep.svg. After editing, render it again with:
#   d2 --layout=elk --theme=0 --dark-theme=200 --pad=30 docs/architecture-upkeep.d2 docs/architecture-upkeep.svg
direction: down

classes: {
  you: {style: {fill: "#e6ecfc"; stroke: "#1f4fd8"; stroke-width: 2; border-radius: 14; font-size: 17; font-color: "#141a24"}}
  cf: {style: {fill: "#fcefe0"; stroke: "#c25e00"; stroke-width: 2; border-radius: 14; font-size: 17; font-color: "#141a24"}}
  server: {style: {fill: "#e3f3ea"; stroke: "#1d7a4c"; stroke-width: 2; border-radius: 14; font-size: 17; font-color: "#141a24"}}
  do: {style: {fill: "#e2f1fa"; stroke: "#0b6fa8"; stroke-width: 2; border-radius: 14; font-size: 17; font-color: "#141a24"}}
  out: {style: {fill: "#f1f3f6"; stroke: "#8a94a6"; stroke-width: 2; stroke-dash: 4; border-radius: 14; font-size: 16; font-color: "#141a24"}}
  group: {style: {fill: transparent; stroke: "#8a94a6"; stroke-dash: 3; border-radius: 16; font-size: 19; bold: true}}
  step: {style: {stroke: "#141a24"; stroke-width: 2; font-size: 15; font-color: "#141a24"}}
}

alerts: "Alerts reach your phone" {
  class: group
  direction: right
  server: "joyshare server\nvideo ready, problems" {class: server}
  kuma: "Uptime Kuma (DigitalOcean)\nthe site stopped answering" {class: do}
  ntfy: "ntfy" {class: out}
  phone: "Your phone" {class: you}
  server -> ntfy {class: step}
  kuma -> ntfy {class: step}
  ntfy -> phone: "push alert" {class: step}
}

updates: "New versions arrive" {
  class: group
  direction: right
  github: "GitHub\nnew joyshare code" {class: out}
  helper: "Update helper\nruns the tests" {class: server}
  pypi: "PyPI\nnew yt-dlp" {class: out}
  server: "joyshare server\nrestarts with it" {class: server}
  github -> helper {class: step}
  helper -> server: "tests passed" {class: step}
  pypi -> server: "daily check" {class: step}
}

backups: "A copy is kept safe" {
  class: group
  direction: right
  server: "joyshare server\ndatabase" {class: server}
  r2: "Cloudflare R2\nbackup copy" {class: cf; shape: cylinder}
  server -> r2: "every day" {class: step}
}

alerts -> updates: {style.opacity: 0}
updates -> backups: {style.opacity: 0}
