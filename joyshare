#!/usr/bin/env bash
# joyshare helper for the person who runs the server. Everything is controlled from here.
#
#   ./joyshare start                    Start everything (or apply changes made in .env)
#   ./joyshare stop                     Stop everything. Data is kept.
#   ./joyshare restart                  Stop, then start
#   ./joyshare update                   Rebuild after getting new code, then start
#   ./joyshare status                   What is running, and whether it is healthy
#   ./joyshare logs [web|worker|tunnel|caddy]   Follow what it is doing (Ctrl+C to leave)
#   ./joyshare test                     Run the automated tests
#
#   ./joyshare backup [--with-videos]   Pack everything joyshare knows into one file in ./backups
#   ./joyshare restore FILE [--yes]     Replace all joyshare data with a file made by "backup"
#   ./joyshare restore-db FILE [--yes]  Put back just the database from a nightly snapshot (.db.gz)
#   ./joyshare setup-code               Print a one-time code to register a device (first run or lockout)
#
#   ./joyshare autoupdate on [MINUTES]  Put new code from GitHub (main) live by itself, checking every 5 minutes
#   ./joyshare autoupdate off|status    Stop doing that, or show whether it is on and what it did last
#   ./joyshare self-update              One check now: if main moved, test the new code, wait for running videos, update
#
#   ./joyshare retire                   This computer no longer runs joyshare (it moved): stop and stay stopped
#   ./joyshare unretire                 Allow this computer to run joyshare again
#
# Optional parts are turned on by what is in .env:
#   CLOUDFLARE_TUNNEL_TOKEN  -> the Cloudflare Tunnel container
#   JOYSHARE_DOMAIN          -> the Caddy web server (https without Cloudflare)
#
# Moving to another computer: docs/MOVING-MAC.md and docs/MOVING-LINUX.md.
set -euo pipefail
cd "$(dirname "$0")"

# The compose command. Set JOYSHARE_COMPOSE="podman compose" to use Podman instead of Docker.
COMPOSE="${JOYSHARE_COMPOSE:-docker compose}"

say() { printf '%s\n' "$*"; }
die() { say "Error: $*" >&2; exit 1; }

confirm() {
  [[ "${ASSUME_YES:-0}" == "1" ]] && return 0
  read -r -p "$1 Type yes to continue: " answer
  [[ "$answer" == "yes" ]] || die "Stopped. Nothing was changed."
}

# Runs a command in a throwaway container that sees the data volume at /data and one host folder.
in_data() { # in_data HOST_FOLDER MOUNT_POINT COMMAND...
  local host="$1" mount="$2"; shift 2
  $COMPOSE run --rm --no-deps -T --user root -v "$host:$mount" web "$@"
}

# A value from .env (empty when the line is missing or commented out).
setting() {
  [[ -f .env ]] || return 0
  { grep -E "^[[:space:]]*$1=" .env || true; } | tail -n 1 | cut -d= -f2- | sed -e 's/^["'"'"']//' -e 's/["'"'"'][[:space:]]*$//' -e 's/[[:space:]]*$//'
}

# The optional containers this computer should run, worked out from .env.
wanted=()
[[ -n "$(setting CLOUDFLARE_TUNNEL_TOKEN)" ]] && wanted+=(tunnel)
[[ -n "$(setting JOYSHARE_DOMAIN)" ]] && wanted+=(caddy)
WANTED="$(IFS=,; echo "${wanted[*]:-}")"
export COMPOSE_PROFILES="$WANTED"
everything() { COMPOSE_PROFILES="tunnel,caddy" $COMPOSE "$@"; }   # for stopping: reach the optional ones too

RETIRED=".retired"
not_retired() {
  [[ -f "$RETIRED" ]] || return 0
  die "This computer was retired from running joyshare on $(cat "$RETIRED").
If it runs here while another computer also runs it, visitors land on either one at random.
To run it here again, first stop it on the other computer, then: ./joyshare unretire"
}

# Two tunnel containers with the same token means Cloudflare splits visitors between them.
stray_tunnel() {
  local engine="${COMPOSE%% *}" ours others
  [[ " ${wanted[*]:-} " == *" tunnel "* ]] || return 0
  ours="$($COMPOSE ps -q 2>/dev/null || true)"
  others="$($engine ps --format '{{.ID}} {{.Image}} {{.Names}}' 2>/dev/null | grep -i cloudflared || true)"
  while read -r id image name; do
    [[ -z "$id" ]] && continue
    grep -q "^$id" <<<"$ours" && continue
    say ""
    say "Warning: another Cloudflare Tunnel container is running here: $name"
    say "If it uses the same tunnel, remove it so only one is connected:  $engine rm -f $name"
  done <<<"$others"
}

# ---------- updating by itself (see "autoupdate" and "self-update" below) ----------
AUTO_LOG="logs/autoupdate.log"
AUTO_MARK=".autoupdate-stopped"   # the commit (or problem) already reported, so it is reported once
AUTO_LOCK=".autoupdate.lock"
AUTO_LABEL="com.joyshare.autoupdate"
AUTO_PLIST="$HOME/Library/LaunchAgents/$AUTO_LABEL.plist"
AUTO_UNITS="$HOME/.config/systemd/user"
stamp() { date "+%Y-%m-%d %H:%M:%S"; }
note() { say "$(stamp)  $*"; }

# Tell the admin's phone (ntfy, set up in the admin panel) that new code was not put live.
alert_update_failed() {
  $COMPOSE exec -T web python -m app.cli update-failed "$*" 2>&1 || say "(No alert sent: joyshare is not running.)"
}

# Report a problem once (in the log and as an alert), then stay quiet until it changes.
stop_once() { # stop_once KEY MESSAGE
  [[ -f "$AUTO_MARK" && "$(cat "$AUTO_MARK")" == "$1" ]] && exit 0
  printf '%s\n' "$1" > "$AUTO_MARK"
  mkdir -p logs
  note "Not updating: $2" >> "$AUTO_LOG"
  alert_update_failed "$2" >> "$AUTO_LOG"
  exit 1
}

summary() {
  say "Address:        $(setting JOYSHARE_PUBLIC_URL || true)"
  say "On this machine: http://localhost:$(v="$(setting JOYSHARE_PORT)"; echo "${v:-8080}")"
  say "Optional parts:  ${WANTED:-none} (from .env)"
}

command="${1:-}"
[[ "${*: -1}" == "--yes" ]] && ASSUME_YES=1

case "$command" in
  start)
    not_retired
    $COMPOSE up -d --remove-orphans
    summary; stray_tunnel
    ;;

  stop)
    everything stop
    say "Stopped. Your data is kept. Start again with: ./joyshare start"
    ;;

  restart)
    not_retired
    everything stop
    $COMPOSE up -d --remove-orphans
    summary; stray_tunnel
    ;;

  update)
    not_retired
    $COMPOSE up -d --build --remove-orphans
    summary; stray_tunnel
    ;;

  status)
    [[ -f "$RETIRED" ]] && say "This computer is retired from running joyshare (since $(cat "$RETIRED"))."
    everything ps
    say ""
    summary
    $COMPOSE exec -T web python -c "
import json, urllib.request
try:
    h = json.load(urllib.request.urlopen('http://127.0.0.1:8080/api/health', timeout=3))
    print('Website:         answering')
    print('Worker:         ', 'running' if h.get('worker_alive') else 'NOT running')
except Exception as exc:
    print('Website:         NOT answering:', exc)
" 2>/dev/null || say "Website:         not running"
    stray_tunnel
    ;;

  logs)
    if [[ -n "${2:-}" ]]; then everything logs -f --tail 100 "$2"; else everything logs -f --tail 100; fi
    ;;

  test)
    $COMPOSE build -q web
    $COMPOSE run --rm --no-deps -T web python -m pytest -q tests
    ;;

  self-update)
    not_retired
    # One run at a time. A lock left by a crash is cleared after two hours.
    [[ -d "$AUTO_LOCK" && -n "$(find "$AUTO_LOCK" -maxdepth 0 -mmin +120 2>/dev/null)" ]] && rmdir "$AUTO_LOCK"
    mkdir "$AUTO_LOCK" 2>/dev/null || exit 0
    trap 'rmdir "$AUTO_LOCK" 2>/dev/null || true' EXIT

    # Nothing is written while nothing changes, so the log only holds real updates.
    git fetch --quiet origin main 2>/dev/null || exit 0   # offline for now: try again next time
    here="$(git rev-parse HEAD)"; there="$(git rev-parse FETCH_HEAD)"
    [[ "$here" == "$there" ]] && exit 0
    [[ "$(git rev-parse --abbrev-ref HEAD)" == "main" ]] \
      || stop_once "branch:$(git rev-parse --abbrev-ref HEAD)" "this copy is on branch $(git rev-parse --abbrev-ref HEAD), not main. Run: git switch main"
    git merge-base --is-ancestor HEAD "$there" \
      || stop_once "diverged:$there" "this copy has commits that are not on GitHub's main, so it can't simply move forward."
    [[ -z "$(git status --porcelain --untracked-files=no)" ]] \
      || stop_once "changed:$there" "files were changed by hand in $PWD (see: git status)."
    [[ -f "$AUTO_MARK" && "$(cat "$AUTO_MARK")" == "$there" ]] && exit 0   # these tests already failed

    mkdir -p logs
    [[ -f "$AUTO_LOG" && "$(wc -c < "$AUTO_LOG")" -gt 1000000 ]] && mv -f "$AUTO_LOG" "$AUTO_LOG.old"
    exec >> "$AUTO_LOG" 2>&1
    short="$(git rev-parse --short "$there")"; subject="$(git log -1 --format=%s "$there")"
    note "New code on main: $short $subject"

    # Test the new code in its own folder and image, so the running version is not touched.
    engine="${COMPOSE%% *}"
    trial="$(mktemp -d)"
    trap 'git worktree remove --force "$trial/code" >/dev/null 2>&1 || true; rm -rf "$trial"; rmdir "$AUTO_LOCK" 2>/dev/null || true' EXIT
    git worktree prune
    git worktree add --quiet --detach "$trial/code" "$there"
    note "Testing $short…"
    if ! { $engine build -q -t joyshare:candidate "$trial/code" >/dev/null && $engine run --rm joyshare:candidate python -m pytest -q tests; }; then
      printf '%s\n' "$there" > "$AUTO_MARK"
      note "The tests failed. Staying on $(git rev-parse --short HEAD)."
      alert_update_failed "the tests failed on $short ($subject). Details in $AUTO_LOG on $(hostname -s)."
      exit 1
    fi
    $engine image rm joyshare:candidate >/dev/null 2>&1 || true

    # Wait up to 30 minutes while a video is being made, so nobody's video is cut off.
    for i in $(seq 60); do
      $COMPOSE exec -T web python -m app.cli busy >/dev/null 2>&1 || break
      [[ "$i" == 1 ]] && note "A video is being made. Waiting for it to finish…"
      sleep 30
    done
    if $COMPOSE exec -T web python -m app.cli busy >/dev/null 2>&1; then
      note "Videos are still being made after 30 minutes. Trying again next time."
      exit 0
    fi

    git merge --ff-only --quiet "$there"
    rm -f "$AUTO_MARK"
    if ./joyshare update; then   # a fresh run, so it uses the new script too
      note "Updated to $short. Live now."
    else
      note "The update to $short failed while starting."
      alert_update_failed "the update to $short failed while starting. Details in $AUTO_LOG on $(hostname -s)."
      exit 1
    fi
    ;;

  autoupdate)
    case "${2:-status}" in
      on)
        minutes="${3:-5}"
        [[ "$minutes" =~ ^[0-9]+$ ]] && (( minutes >= 1 && minutes <= 1440 )) || die "Give the minutes between checks as a number from 1 to 1440, for example: ./joyshare autoupdate on 5"
        not_retired
        [[ "$(git rev-parse --abbrev-ref HEAD)" == "main" ]] || die "This copy is not on main. Run git switch main first."
        mkdir -p logs
        me="$PWD/joyshare"
        if [[ "$(uname)" == "Darwin" ]]; then
          mkdir -p "$(dirname "$AUTO_PLIST")"
          cat > "$AUTO_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$AUTO_LABEL</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>$me</string><string>self-update</string></array>
  <key>WorkingDirectory</key><string>$PWD</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>$PATH</string></dict>
  <key>StartInterval</key><integer>$(( minutes * 60 ))</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>$PWD/$AUTO_LOG</string>
  <key>StandardErrorPath</key><string>$PWD/$AUTO_LOG</string>
</dict>
</plist>
PLIST
          launchctl bootout "gui/$(id -u)/$AUTO_LABEL" 2>/dev/null || true
          launchctl bootstrap "gui/$(id -u)" "$AUTO_PLIST"
        elif command -v systemctl >/dev/null; then
          mkdir -p "$AUTO_UNITS"
          printf '%s\n' "[Unit]" "Description=joyshare: put new code from GitHub live" "" "[Service]" "Type=oneshot" \
            "WorkingDirectory=$PWD" "Environment=PATH=$PATH" "ExecStart=/bin/bash $me self-update" \
            "StandardOutput=append:$PWD/$AUTO_LOG" "StandardError=append:$PWD/$AUTO_LOG" > "$AUTO_UNITS/joyshare-autoupdate.service"
          printf '%s\n' "[Unit]" "Description=joyshare: check GitHub every $minutes minutes" "" "[Timer]" "OnBootSec=2min" \
            "OnUnitActiveSec=${minutes}min" "" "[Install]" "WantedBy=timers.target" > "$AUTO_UNITS/joyshare-autoupdate.timer"
          systemctl --user daemon-reload
          systemctl --user enable --now joyshare-autoupdate.timer >/dev/null
          say "To keep checking while nobody is signed in to this computer, run once: sudo loginctl enable-linger $(id -un)"
        else
          die "This computer has neither launchd (macOS) nor systemd, so this can't be turned on here."
        fi
        note "Automatic updates on: every $minutes minutes." >> "$AUTO_LOG"
        say "Automatic updates are on. Every $minutes minutes this computer checks GitHub's main and puts new code live."
        say "What it did is written to $AUTO_LOG. Turn it off with: ./joyshare autoupdate off"
        ;;
      off)
        if [[ "$(uname)" == "Darwin" ]]; then
          launchctl bootout "gui/$(id -u)/$AUTO_LABEL" 2>/dev/null || true
          rm -f "$AUTO_PLIST"
        elif command -v systemctl >/dev/null; then
          systemctl --user disable --now joyshare-autoupdate.timer >/dev/null 2>&1 || true
          rm -f "$AUTO_UNITS/joyshare-autoupdate.timer" "$AUTO_UNITS/joyshare-autoupdate.service"
          systemctl --user daemon-reload 2>/dev/null || true
        fi
        mkdir -p logs; note "Automatic updates off." >> "$AUTO_LOG"
        say "Automatic updates are off. Update by hand with: git pull && ./joyshare update"
        ;;
      status)
        if [[ -f "$AUTO_PLIST" || -f "$AUTO_UNITS/joyshare-autoupdate.timer" ]]; then
          every="$(grep -o '<integer>[0-9]*' "$AUTO_PLIST" 2>/dev/null | tr -dc 0-9)"
          [[ -n "$every" ]] && every="$(( every / 60 ))" || every="$(grep -o 'OnUnitActiveSec=[0-9]*' "$AUTO_UNITS/joyshare-autoupdate.timer" 2>/dev/null | tr -dc 0-9)"
          say "Automatic updates: on, every ${every:-?} minutes."
        else
          say "Automatic updates: off. Turn on with: ./joyshare autoupdate on"
        fi
        say "Running version: $(git log -1 --format='%h %s')"
        [[ -f "$AUTO_MARK" ]] && say "Waiting on: $(cat "$AUTO_MARK") (reported once; fix it or push a new commit)"
        if [[ -f "$AUTO_LOG" ]]; then say ""; say "Last entries in $AUTO_LOG:"; grep -E '^[0-9]{4}-' "$AUTO_LOG" | tail -n 8; fi
        ;;
      *) die "Use: ./joyshare autoupdate on [MINUTES] | off | status" ;;
    esac
    ;;

  retire)
    confirm "This stops joyshare on this computer and keeps it stopped, because it now runs somewhere else."
    everything stop
    date "+%Y-%m-%d %H:%M" > "$RETIRED"
    say "Retired. Nothing was deleted: the data is still here if you need to come back."
    say "If the other computer uses the same Cloudflare Tunnel, you can also remove CLOUDFLARE_TUNNEL_TOKEN from this .env."
    ;;

  unretire)
    rm -f "$RETIRED"
    say "This computer may run joyshare again. Make sure no other computer is running it, then: ./joyshare start"
    ;;

  backup)
    mkdir -p backups
    name="joyshare-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
    # Videos are temporary and the yt-dlp copy can be downloaded again, so they are left out unless asked for.
    skip=(--exclude=./cache --exclude=./ytdlp --exclude=./backups)
    [[ "${2:-}" == "--with-videos" ]] || skip+=(--exclude=./media)
    say "Stopping joyshare for a moment so the copy is consistent…"
    $COMPOSE stop web worker >/dev/null
    in_data "$PWD/backups" /out tar czf "/out/$name" "${skip[@]}" -C /data . || { $COMPOSE start web worker >/dev/null; die "The backup failed."; }
    $COMPOSE start web worker >/dev/null
    say "Saved backups/$name ($(du -h "backups/$name" | cut -f1))"
    say "Keep your .env file with it: it is not inside the backup."
    ;;

  restore)
    file="${2:-}"
    [[ -f "$file" ]] || die "Give the backup file, for example: ./joyshare restore backups/joyshare-backup-20261113-101500.tar.gz"
    folder="$(cd "$(dirname "$file")" && pwd)"; name="$(basename "$file")"
    confirm "This replaces ALL current joyshare data with $name."
    not_retired
    say "Getting the app ready (the first time takes a few minutes)…"
    $COMPOSE build -q web   # so this works on a brand-new computer
    $COMPOSE stop web worker >/dev/null 2>&1 || true
    in_data "$folder" /in sh -c "find /data -mindepth 1 -delete && tar xzf '/in/$name' -C /data && mkdir -p /data/media && chown -R app:app /data" \
      || die "The restore failed."
    $COMPOSE up -d --remove-orphans >/dev/null
    say "Restored from $name. joyshare is starting."
    summary
    ;;

  restore-db)
    file="${2:-}"
    [[ -f "$file" && "$file" == *.db.gz ]] || die "Give a nightly snapshot, for example: ./joyshare restore-db joyshare-20261113-030000.db.gz"
    folder="$(cd "$(dirname "$file")" && pwd)"; name="$(basename "$file")"
    confirm "This replaces the joyshare database (people, settings, history) with $name. Videos are not touched."
    $COMPOSE stop web worker >/dev/null 2>&1 || true
    in_data "$folder" /in sh -c "gunzip -c '/in/$name' > /data/joyshare.db.new && rm -f /data/joyshare.db-wal /data/joyshare.db-shm && mv /data/joyshare.db.new /data/joyshare.db && chown app:app /data/joyshare.db" \
      || die "The restore failed."
    $COMPOSE up -d >/dev/null
    say "Database restored from $name. joyshare is starting."
    ;;

  setup-code)
    $COMPOSE exec web python -m app.cli setup-code
    ;;

  *)
    sed -n '2,/^set -euo/p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
