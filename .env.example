# Copy this file to ".env" and change what you need. Every line is optional.

# Port on this computer where joyshare answers (http://localhost:8080).
JOYSHARE_PORT=8080

# The address people use to reach joyshare. Share links are built from it.
# On your laptop leave it as is. When live, set it to https://your-domain.
JOYSHARE_PUBLIC_URL=http://localhost:8080
